# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
# Prefer apps/web/.env.local for Next.js (copy from root .env if needed).
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key when available (hosted projects).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — still emitted by local CLI; use if publishable is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefer secret key when available (hosted). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT — local CLI default. Server-only. Never use in Client Components.
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
# Used for email verification redirects (e.g. /auth/callback).
# In Supabase Dashboard → Authentication → URL Configuration, set:
#   Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs include {NEXT_PUBLIC_APP_URL}/auth/callback

# AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email
# RESEND_API_KEY=
# EMAIL_FROM=noreply@ordra.app

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
LOG_LEVEL=info
