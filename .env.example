# Email
# RESEND_API_KEY=
# EMAIL_FROM=noreply@ordra.app

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
LOG_LEVEL=info
